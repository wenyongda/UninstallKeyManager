<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UninstallKeyManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UninstallKeyManager"
    xmlns:models="using:UninstallKeyManager.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="控制面板隐藏管理器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Root layout: 4 rows — filters, actions, main content, status bar -->
    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- FILTER ROW                                             -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Source filter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="来源："
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="SourceFilterComboBox"
                              Width="170"
                              SelectionChanged="SourceFilter_SelectionChanged">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="系统级 (HKLM)" />
                        <ComboBoxItem Content="用户级 (HKCU)" />
                    </ComboBox>
                </StackPanel>

                <!-- Hidden-state filter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="显示状态："
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="StatusFilterComboBox"
                              Width="170"
                              SelectionChanged="StatusFilter_SelectionChanged">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="已隐藏（不在控制面板显示）" />
                        <ComboBoxItem Content="未隐藏（控制面板可见）" />
                    </ComboBox>
                </StackPanel>

                <!-- Search box -->
                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Column="4"
                                PlaceholderText="搜索应用名称、发布者或键名…"
                                QueryIcon="Find"
                                VerticalAlignment="Center"
                                TextChanged="SearchBox_TextChanged" />
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ACTION ROW                                             -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Hidden summary -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SummaryTextBlock"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind SummaryLine, Mode=OneWay}" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RefreshButton"
                            Click="Refresh_Click"
                            ToolTipService.ToolTip="重新扫描注册表">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="刷新" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button x:Name="BatchHideButton"
                            Content="批量隐藏"
                            Click="BatchHide_Click"
                            ToolTipService.ToolTip="把选中的应用从控制面板隐藏" />

                    <Button x:Name="BatchShowButton"
                            Content="批量显示"
                            Click="BatchShow_Click"
                            ToolTipService.ToolTip="把选中的应用重新显示到控制面板" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT: SplitView with list + detail drawer       -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <SplitView Grid.Row="2"
                   x:Name="DetailSplitView"
                   IsPaneOpen="{x:Bind IsDetailOpen, Mode=TwoWay}"
                   OpenPaneLength="400"
                   PanePlacement="Right"
                   CompactPaneLength="0">

            <!-- MAIN CONTENT: ListView -->
            <Grid>
                <ListView x:Name="EntriesListView"
                          ItemsSource="{x:Bind Entries}"
                          SelectionChanged="EntriesListView_SelectionChanged"
                          SelectionMode="Multiple"
                          Padding="8,4">

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:UninstallEntry">
                            <Grid Padding="12,10" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- App info -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{x:Bind Publisher}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>

                                <!-- Badges -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="6">

                                    <!-- Hidden badge -->
                                    <Border CornerRadius="4"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind HiddenBadgeBrush}"
                                            Visibility="{x:Bind HiddenBadgeVisibility}"
                                            ToolTipService.ToolTip="SystemComponent = 1，控制面板中不显示">
                                        <TextBlock Text="已隐藏"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <!-- 32-bit view badge -->
                                    <Border CornerRadius="4"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind View32BadgeBrush}"
                                            Visibility="{x:Bind View32BadgeVisibility}"
                                            ToolTipService.ToolTip="32 位注册表视图（WOW6432Node）">
                                        <TextBlock Text="32 位"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <!-- Source badge -->
                                    <Border CornerRadius="4"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind SourceBadgeBrush}">
                                        <TextBlock Text="{x:Bind SourceDisplay}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <!-- Empty state -->
                    <ListView.Header>
                        <TextBlock x:Name="EmptyStateText"
                                   Text="没有匹配的应用"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Padding="0,40"
                                   Visibility="Collapsed" />
                    </ListView.Header>
                </ListView>
            </Grid>

            <!-- DETAIL PANE -->
            <SplitView.Pane>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid Padding="20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Pane header -->
                        <Grid>
                            <TextBlock Text="详细信息"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="CloseDetailButton"
                                    Content="✕"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Click="CloseDetail_Click"
                                    ToolTipService.ToolTip="关闭" />
                        </Grid>

                        <!-- Detail content -->
                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,8,0">
                            <StackPanel Spacing="20">

                                <!-- Section: Basic info -->
                                <StackPanel>
                                    <TextBlock Text="基本信息"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,8" />

                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="显示名称"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{x:Bind SelectedItem.DisplayName, Mode=OneWay}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="发布者"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{x:Bind SelectedItem.Publisher, Mode=OneWay}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="版本"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Text="{x:Bind SelectedItem.DisplayVersion, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Section: Hidden state -->
                                <StackPanel>
                                    <TextBlock Text="控制面板显示状态"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,8" />

                                    <ToggleSwitch x:Name="HideSwitch"
                                                  Header="在控制面板中隐藏此应用"
                                                  OnContent="已隐藏"
                                                  OffContent="未隐藏"
                                                  IsOn="{x:Bind SelectedItem.IsSystemComponent, Mode=OneWay}"
                                                  Toggled="HideSwitch_Toggled" />

                                    <TextBlock Text="勾选后写入 SystemComponent（DWORD 32 位）= 1，控制面板将不再列出该应用；应用本身不受影响，仍可通过卸载命令卸载。若同一键名同时存在于 32 位和 64 位视图，两个视图都会被写入，否则应用仍会从另一个视图显示。"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>

                                <!-- Section: Paths -->
                                <StackPanel>
                                    <TextBlock Text="路径信息"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,8" />

                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="安装路径"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{x:Bind SelectedItem.InstallLocation, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontSize="12" />

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="卸载命令"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{x:Bind SelectedItem.UninstallString, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontSize="12" />
                                    </Grid>
                                </StackPanel>

                                <!-- Section: Registry -->
                                <StackPanel>
                                    <TextBlock Text="注册表信息"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,8" />

                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="来源"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{x:Bind SelectedItem.SourceDisplay, Mode=OneWay}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="注册表视图"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{x:Bind SelectedItem.ViewsDisplay, Mode=OneWay}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="键名"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Text="{x:Bind SelectedItem.KeyName, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontSize="12" />

                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Text="注册表路径"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Text="{x:Bind SelectedItem.RegistryPath, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontSize="12" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </SplitView.Pane>
        </SplitView>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- STATUS BAR                                               -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind StatusLine, Mode=OneWay}" />

                <TextBlock x:Name="ScanNoteText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ScanNote, Mode=OneWay}" />
            </Grid>
        </Border>

    </Grid>
</Window>
